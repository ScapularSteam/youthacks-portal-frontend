---
import Head from "../components/shared/head.astro"
import Default from "../templates/default.astro"
import EventCard from "../components/reusable/event-card.astro"

// Define an event datatype
type Event = {
  logo: string;
  name: string;
  date: string;
  description: string;
  address: string;
};

const response = await fetch("https://youthacks-portal.vercel.app/testing/event/");
const data: Event[] = await response.json();
---

<html lang="en">
	<Default>
		<!-- Dynamically render every event returned from API -->
		<div class="flex flex-row">
			{
				data.map(event => (
					<EventCard
						src={event.logo}
						title={event.name}
						date={event.date}
						description={event.description}
						address={event.address}
						edit_link="https://example.com"
						view_link="https://example.com" 
					/>
				))
			}
		</div>
	</Default>
</html>
