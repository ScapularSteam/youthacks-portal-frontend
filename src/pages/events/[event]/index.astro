---
// todo - render details about a specific event
// google maps api key: AIzaSyCovJJSkYYopeJUMAhi4-9b8XfFkTxsYyg
import Default from "../../../templates/default.astro";
import EventNavbar from "../../../components/reusable/event-navbar.astro";
import EventsHero from "../../../components/shared/events/events-hero.astro";

// Parse address into google maps friendly format

type Event = {
  id: string;
  logo: string;
  name: string;
  date: string;
  description: string;
  address: string;
};

const { event } = Astro.params;

// Fetch the specific event data
const response = await fetch("https://youthacks-portal.vercel.app/testing/event/");
const data: Event[] = await response.json();
const currentEvent = data.find(e => e.id == event);

const address_formatted = currentEvent?.address.replaceAll(" ", "+")

if (!currentEvent || currentEvent == null) {
  return Astro.redirect("/404");
}

---

<Default>
    <EventsHero/>

    <div class="mt-12 ml-12">
			<div class="mb-4">
				<h1 class="text-3xl font-worksans font-semibold!">Address</h1>
				<p>{currentEvent.address}</p>
			</div>
			
		 </div>

    <div class="m-12">
        <iframe width="500" height="350" style="border:0" loading="lazy" allowfullscreen
            src={`https://www.google.com/maps/embed/v1/search?q=${address_formatted}&key=AIzaSyCovJJSkYYopeJUMAhi4-9b8XfFkTxsYyg`}
            class="rounded-2xl shadow-md"
            >
        </iframe> 
    </div>
</Default>