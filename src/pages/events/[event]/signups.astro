---
// todo - render all signups for a given event
import Default from "../../../templates/default.astro";
import SignupCard from "../../../components/cards/signup-card.astro"
import SignupCardRenderer from "../../../components/renderers/signup-card-renderer.astro";
import EventsHero from "../../../components/shared/events/events-hero.astro";

type Event = {
  id: string;
  logo: string;
  name: string;
  date: string;
  description: string;
  address: string;
};

type Attendee = {
    id: string;
    first_name: string;
    last_name: string;
    prefered_name: string;
    email: string;
    mobile_number: string;
    address: string;
    dob: string;
    medical_info: string;
    dietary_requirements: string;
};

type Signup = {
    id: string;
    attendee: Attendee;
    waiver_id: string;
    waiver_signed: string;
    date_created: string;
};


const { event } = Astro.params;

// Fetch the specific event data
const event_response = await fetch("https://youthacks-portal.vercel.app/testing/event/");
const event_data: Event[] = await event_response.json();
const currentEvent = event_data.find(e => e.id == event);

const signup_endpoint = "https://youthacks-portal.vercel.app/testing/attendee_signup/event_id/" + currentEvent.id
const signup_response = await fetch(signup_endpoint)
const signup_data: Signup[] = await signup_response.json();


if (!currentEvent || currentEvent == null) {
  return Astro.redirect("/404");
}
---
<Default>
    <EventsHero/>
    <div class="mt-12 ml-12">
			<div class="mb-4">
				<h1 class="text-3xl font-worksans font-semibold!">Signups for {currentEvent.name}</h1>
				<p>Can't find a signup? Contact hello@youthacks.org for help!</p>
			</div>
			
		 </div>
    <SignupCardRenderer/>
    

    
    
</Default>