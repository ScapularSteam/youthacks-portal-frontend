---
import SignupCard from "../cards/signup-card.astro";

type Event = {
  id: string;
  logo: string;
  name: string;
  date: string;
  description: string;
  address: string;
};

type Attendee = {
    id: string;
    first_name: string;
    last_name: string;
    prefered_name: string;
    email: string;
    mobile_number: string;
    address: string;
    dob: string;
    medical_info: string;
    dietary_requirements: string;
};

type Signup = {
    id: string;
    attendee: Attendee;
    waiver_id: string;
    waiver_signed: string;
    date_created: string;
};


const { event } = Astro.params;

// Fetch the specific event data
const event_response = await fetch("https://youthacks-portal.vercel.app/testing/event/");
const event_data: Event[] = await event_response.json();
const currentEvent = event_data.find(e => e.id == event);

const signup_endpoint = "https://youthacks-portal.vercel.app/testing/attendee_signup/event_id/" + currentEvent.id
const signup_response = await fetch(signup_endpoint)
const signup_data: Signup[] = await signup_response.json();


if (!currentEvent || currentEvent == null) {
  return Astro.redirect("/404");
}
---
<div class="flex flex-row flex-wrap gap-4">
    {
        // Map each event in array to EventCard component by passing attributes through as props
        signup_data.map(signup => (
            <SignupCard
                status="Not implemented"
                prefered_name={signup.attendee.prefered_name}
                first_name={signup.attendee.first_name}
                last_name={signup.attendee.last_name}
                email={signup.attendee.email}
                medical_info={signup.attendee.medical_info}
                dietary_requirements={signup.attendee.dietary_requirements}
                id={signup.attendee.id}
            />
        ))
    }
</div>
