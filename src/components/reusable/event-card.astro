---
const { src, title, date, description, address, edit_link, view_link } = Astro.props;
// https://placehold.co/600x400
---

<div class="card bg-base-200 w-96 shadow-sm hover:shadow-md">
    <div>
        <img class="w-80 h-40 object-contain p-4 mx-auto" src={src}>
    </div>
    <div class="card-body">
        <h2 class="card-title font-worksans font-semibold!">{title}</h2>
        <div class="flex flex-col justify-evenly h-32">
            <p class="font-worksans font-medium!">{description}</p>
            <h3 class="font-worksans italic">Date: {date}</h3>
            <p class="font-worksans italic">Address: {address}</p>
        </div>
        <div class="card-actions justify-start">
            <a class="btn btn-primary font-worksans" href={edit_link}>Edit event</a>
            <a class="btn btn-secondary font-worksans" href={view_link}>View website</a>
        </div>
    </div>
</div>