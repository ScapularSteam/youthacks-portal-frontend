---
const { event_id } = Astro.props
---
<div class="flex flex-row w-screen justify-center bg-base-200 border-y-2 border-base-300">
    <a href={`/events/${event_id}`} class="btn btn-ghost">Details</a>
    <a href={`/events/${event_id}/signups`} class="btn btn-ghost">Signups</a>
    <a href={`/events/${event_id}/documents`} class="btn btn-ghost">Documents</a>
</div>