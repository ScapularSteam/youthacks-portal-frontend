---
const { status, prefered_name, first_name, last_name, email, medical_info, dietary_requirements, id } = Astro.props;
const attendee_link = "/attendees/" + id;
---


<div class="card bg-base-200 w-96 shadow-sm hover:shadow-md">
    <div class="card-body">
        <h2 class="card-title">{prefered_name}</h2>

        <div class="badge badge-ghost badge-outline p-4 my-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
            </svg>

            <p>{status}</p>
        </div>

        <div class="bg-base-100 border border-base-300 rounded-lg p-4">
            <p>First name: {first_name}</p>
            <p>Last name: {last_name}</p>
            <p>Email: {email}</p>
        </div>

        <!-- Accordion style dropdown to visually obscure sensitive info -->
        <details class="collapse bg-base-100 border border-base-300 hover:bg-base-200" name="signup-accordion">
            <summary class="collapse-title flex flex-row"><p>Medical + Dietary requirements</p>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>

            </summary>
            <div class="collapse-content">
                <p>Medical info: {medical_info}</p>
                <p>Dietary requirements: {dietary_requirements}</p>
            </div>
        </details>

        <div class="card-actions justify-end my-4">
            <a href={attendee_link} class="btn btn-outline">View all details</a>
        </div>

    </div>
</div>